<%- include('partials/head', { title: t('certificate_verify_title'), lang }) %>
<%- include('partials/nav', { lang, t, user: null }) %>

<section class="hero">
  <div class="container">
    <h1><%= t('certificate_verify_title') %></h1>

    <% if (!attempt || !attempt.passed) { %>
      <p class="lead"><%= t('certificate_verify_invalid') %></p>
    <% } else { %>
      <p class="lead" style="color: var(--sage); font-weight:700;"><%= t('certificate_verify_valid') %></p>
      <div class="certificate-sheet certificate-sheet-compact">
        <p class="certificate-line"><%= t('certificate_awarded_to') %></p>
        <p class="certificate-name"><%= attempt.users ? attempt.users.name : '' %></p>
        <p class="certificate-line">
          <%= t('certificate_completed') %>
          <strong><%= attempt.modules ? (lang === 'pt' ? attempt.modules.title_pt : attempt.modules.title_en) : '' %></strong>
        </p>
        <div class="certificate-meta">
          <div>
            <span class="certificate-meta-label"><%= t('certificate_score') %></span>
            <strong><%= attempt.score %>/<%= attempt.total %> (<%= attempt.percentage %>%)</strong>
          </div>
          <div>
            <span class="certificate-meta-label"><%= t('certificate_date') %></span>
            <strong><%= new Date(attempt.created_at).toLocaleDateString(lang === 'pt' ? 'pt-PT' : 'en-GB') %></strong>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
